  },
  {
    "line": 184,
    "pdf_page": 7,
    "pdf_page_end": 7,
    "text": "苦情・トラブルの件数、対応状況 ○"
  },
  {
    "line": 185,
    "pdf_page": 7,
    "pdf_page_end": 7,
